# OBB Setter Floor Dashboard: environment. Copy to .env and fill in. NEVER commit .env.

# SID (GoHighLevel) private integration token, scoped to the SID location.
SID_TOKEN=

# Slack incoming webhook for the obb-lead-alerts channel (floor monitor + QC auditor).
SLACK_WEBHOOK_URL=

# Optional: dialer API for the dials column. Leave blank until the local-presence
# blocker is resolved (AloeWare vs Dialer.io). The board renders dials as null and
# skips the attempt-integrity check rather than showing a false alarm.
DIALER_TOKEN=
